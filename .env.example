## ConductorX — Environment Variables
## Copy this file to .env and fill in all values before running scripts/deploy.sh
##
## Generate secrets with:
##   openssl rand -hex 32

# ── GitHub Webhook ─────────────────────────────────────────────────────────────
# HMAC secret — must match the secret set in GitHub → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=

# ── HuggingFace quad pipeline ──────────────────────────────────────────────────
# Read/write token from https://huggingface.co/settings/tokens
HF_API_TOKEN=
# Override only if hosting a fork of the pipeline
HF_PIPELINE_URL=https://huggingface.co/NaTo1000/iNFINITEAi2025

# ── Celery / Redis ─────────────────────────────────────────────────────────────
# Redis is internal to the Docker network — do NOT expose port 6379 publicly
CELERY_BROKER_URL=redis://conductor-redis:6379/0
CELERY_RESULT_BACKEND=redis://conductor-redis:6379/0

# ── Mesh (Tailscale) ───────────────────────────────────────────────────────────
# Auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=
# Friendly hostname this node will appear as in the Tailscale admin panel
CONDUCTOR_HOSTNAME=conductor-vps

# ── Indexer (optional) ────────────────────────────────────────────────────────
INDEXER_URL=
INDEXER_TOKEN=

# ── PayPal payment wall ────────────────────────────────────────────────────────
# Get from https://developer.paypal.com → My Apps & Credentials → Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for real payments
PAYPAL_MODE=sandbox
# Webhook ID from PayPal developer dashboard (for signature verification)
PAYPAL_WEBHOOK_ID=
# One-time access price in USD (e.g. 9.99)
PRICE_USD=9.99
# PayPal billing plan ID for recurring subscriptions (create in PayPal dashboard)
SUBSCRIPTION_PLAN_ID=
# Number of days a one-time purchase JWT remains valid
JWT_ACCESS_DAYS=365

# ── JWT (shared between payment server and webhook server) ─────────────────────
# openssl rand -hex 32
JWT_SECRET=

# ── TLS / domain ──────────────────────────────────────────────────────────────
# Public domain used by Caddy for auto-TLS and for building PayPal callback URLs
DOMAIN=yourdomain.com

# ── Image tag (used by update.sh and rollback.sh) ─────────────────────────────
IMAGE_TAG=latest

# ── GitHub repository (for image URL construction) ────────────────────────────
GITHUB_REPOSITORY=natfunkycat-lab-NaTo1000/Asset-Packs
